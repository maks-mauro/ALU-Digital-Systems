(header "graphic" (version "1.4"))
(pin
	(input)
	(rect 104 48 272 64)
	(text "INPUT" (rect 125 0 153 10)(font "Arial" (font_size 6)))
	(text "entrada[5..0]" (rect 5 0 68 12)(font "Arial" ))
	(pt 168 8)
	(drawing
		(line (pt 84 12)(pt 109 12))
		(line (pt 84 4)(pt 109 4))
		(line (pt 113 8)(pt 168 8))
		(line (pt 84 12)(pt 84 4))
		(line (pt 109 4)(pt 113 8))
		(line (pt 109 12)(pt 113 8))
	)
	(text "VCC" (rect 128 7 148 17)(font "Arial" (font_size 6)))
	(annotation_block (location)(rect 40 64 104 88))
)
(pin
	(output)
	(rect 104 120 280 136)
	(text "OUTPUT" (rect 137 6 175 16)(font "Arial" (font_size 6)))
	(text "led[5..0]" (rect 5 4 45 16)(font "Arial" ))
	(pt 176 8)
	(drawing
		(line (pt 176 8)(pt 124 8))
		(line (pt 124 12)(pt 98 12))
		(line (pt 124 4)(pt 98 4))
		(line (pt 124 4)(pt 124 12))
		(line (pt 98 12)(pt 94 8))
		(line (pt 94 8)(pt 98 4))
		(line (pt 98 4)(pt 94 8))
	)
	(rotate180)
)
(connector
	(pt 272 56)
	(pt 768 56)
	(bus)
)
(connector
	(pt 280 128)
	(pt 768 128)
	(bus)
)
(connector
	(text "<<__$DEF_ALIAS49273>>" (rect 751 109 768 232)(font "Intel Clear" )(vertical)(invisible))
	(pt 768 56)
	(pt 768 128)
	(bus)
)
